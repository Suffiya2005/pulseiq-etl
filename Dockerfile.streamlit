FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && pip install --no-cache-dir -r requirements.txt

COPY app.py .
COPY task18_auth.py .
COPY task18_manager.py .
COPY task18_config.py .

COPY data/clean/ ./data/clean/
COPY data/reference/ ./data/reference/
COPY data/source/ ./data/source/

COPY task4-attendance/data/ ./task4-attendance/data/
COPY task4-attendance/docs/ ./task4-attendance/docs/
COPY logs/run_summary.json ./logs/run_summary.json

RUN mkdir -p reports

EXPOSE 8501

CMD ["streamlit", "run", "app.py", "--server.address=0.0.0.0", "--server.port=8501", "--server.headless=true"]
