# Copy to .streamlit/secrets.toml locally or configure equivalent
# Streamlit Community Cloud Secrets. Never commit real secrets.
[auth.users.admin]
role = "ADMIN"
password_hash = "REPLACE_WITH_SALT_HEX$PBKDF2_SHA256_HEX"

[auth.users.hr]
role = "HR"
password_hash = "REPLACE_WITH_SALT_HEX$PBKDF2_SHA256_HEX"

[auth.users.executive]
role = "EXECUTIVE"
password_hash = "REPLACE_WITH_SALT_HEX$PBKDF2_SHA256_HEX"

# Manager accounts MUST have explicit department_ids.
# [auth.users.manager1]
# role = "MANAGER"
# department_ids = ["D01"]
# team_ids = ["TEAM-01"]
# password_hash = "REPLACE_WITH_SALT_HEX$PBKDF2_SHA256_HEX"
